{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "check:budget": "node scripts/check-budget.mjs",
    "check:libs": "node scripts/check-libs.mjs",
    "skills:index": "node scripts/build-skills-index.mjs",
    "predev": "node scripts/build-skills-index.mjs --quiet",
    "prebuild": "node scripts/build-skills-index.mjs --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "js-tiktoken": "^1.0.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
